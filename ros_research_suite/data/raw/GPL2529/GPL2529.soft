!Platform_organism = Schizosaccharomyces pombe
!Platform_organism = Saccharomyces cerevisiae
!Platform_taxid = 4896
!Platform_taxid = 4932
!Platform_manufacturer = Affymetrix
!Platform_manufacture_protocol = The sequence information for this array was selected from public data sources GenBank® (May 2004) and Sanger Center (June 2004) for the S. cerevisiae and S. pombe genomes, respectively. Probe sets on the array include 11 oligonucleotide pairs to detect each transcript.
!Platform_catalog_number = 900553
!Platform_support = silicon
!Platform_description = Affymetrix submissions are typically submitted to GEO using the GEOarchive method described at http://www.ncbi.nlm.nih.gov/projects/geo/info/geo_affy.html
!Platform_description = 
!Platform_description = The GeneChip® Yeast Genome 2.0 Array contains probe sets to detect transcripts from both Saccharomyces cerevisiae and Schizosaccharomyces pombe, which are the two most commonly studied species of yeast. Providing comprehensive coverage of both species, the GeneChip Yeast Genome 2.0 Array includes approximately 5,744 probe sets for 5,841 of the 5,845 genes present in S. cerevisiae and 5,021 probe sets for all 5,031 genes present in S. pombe
!Platform_web_link = http://www.affymetrix.com/support/technical/byproduct.affx?product=yeast-20
